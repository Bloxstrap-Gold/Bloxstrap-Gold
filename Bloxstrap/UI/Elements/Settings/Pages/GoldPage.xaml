<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.GoldPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      d:DataContext="{d:DesignInstance Type=models:GoldViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="1200" d:DesignWidth="800"
      Title="Bloxstrap Gold"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <!-- Subtitle -->
        <TextBlock Margin="0,0,0,12" Text="The ultimate luxury Roblox bootstrapper with built-in multi-instance client support." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- VIP Membership Card -->
        <Border Padding="16" CornerRadius="8" BorderThickness="1.5"
                BorderBrush="{StaticResource GoldBorderBrush}" Background="{StaticResource GoldDarkGradientBrush}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👑" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BLOXSTRAP GOLD MEMBERSHIP" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldPrimaryBrush}" />
                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="#33FFD700" BorderBrush="#80FFD700" BorderThickness="1">
                                <TextBlock Text="{Binding TrialBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding TrialStatusText}" FontSize="13" Foreground="{StaticResource GoldLightBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Fast-forward / Reset trial tester controls -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,8,0" Content="⚡ Expire Trial (Demo)" Command="{Binding FastForwardTrialCommand}" ToolTip="Fast-forward time by 7 days to test expired trial behavior" />
                    <ui:Button Content="↺ Reset Trial (7 Days)" Command="{Binding ResetTrialCommand}" ToolTip="Reset free trial back to 7 days" />
                </StackPanel>

                <!-- Runaway Pay Button Area -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="12" CornerRadius="6" Background="#261E05" BorderBrush="#66D4AF37" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Subscription Payment Gateway" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource GoldPrimaryBrush}" />
                            <TextBlock Text="Try your best to catch and click the payment button below:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Evasive Runway Canvas -->
                        <Canvas x:Name="PagePayCanvas" Grid.Column="1" Height="44" ClipToBounds="False" Background="Transparent"
                                MouseMove="PagePayCanvas_MouseMove">
                            <ui:Button x:Name="PagePayButton" Content="💳 PAY FOR IT ($999.99)" Appearance="Primary"
                                       Background="{StaticResource GoldGradientBrush}" Foreground="Black" FontWeight="Bold"
                                       BorderBrush="#FFFFFF" BorderThickness="1.5"
                                       Canvas.Left="20" Canvas.Top="4"
                                       MouseEnter="PagePayButton_MouseEnter" Click="PagePayButton_Click" />
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Multi-Instance Roblox Section -->
        <TextBlock Text="Multi-Instance Roblox (Built-in)" FontSize="20" FontWeight="Medium" Margin="0,8,0,0" Foreground="{StaticResource GoldPrimaryBrush}" />
        <TextBlock Text="Run multiple accounts or game sessions simultaneously on a single computer without third-party injectors." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

        <controls:OptionControl 
            Header="Allow multi-instance launching" 
            Description="Intercepts and claims the ROBLOX_singletonMutex handle so multiple Roblox client windows can open without conflict.">
            <ui:ToggleSwitch IsChecked="{Binding MultiInstanceEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- Multi-Instance Actions & Status Card -->
        <Border Margin="0,8,0,0" Padding="14" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Multi-Instance Quick Actions" FontSize="14" FontWeight="Medium" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Singleton Mutex Status: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding MutexStatusText}" FontWeight="SemiBold" Foreground="{StaticResource GoldAccentBrush}" FontSize="12" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Running Roblox Processes: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding RunningRobloxCount}" FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,8,0" Icon="Play24" Content="Launch Extra Roblox" Command="{Binding LaunchExtraRobloxCommand}" Appearance="Primary" />
                    <ui:Button Icon="LockClosedKey24" Content="Toggle Mutex Lock" Command="{Binding UnlockMutexCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Parody Remake Notice -->
        <TextBlock Text="Bloxstrap Gold Clarification &amp; Parody Notice" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" Foreground="{StaticResource GoldPrimaryBrush}" />
        <Border Margin="0,8,0,0" Padding="14" CornerRadius="6" BorderThickness="1.5"
                BorderBrush="{StaticResource GoldBorderBrush}" Background="{StaticResource GoldDarkGradientBrush}">
            <StackPanel>
                <TextBlock Text="👑 This program is a remake &amp; parody of Bloxstrap!" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="Bloxstrap Gold is a satirical joke remake created for fun. The 'paid subscription', '7-day trial', and evasive runaway 'Pay For It' button are entirely a joke — you will never be charged money, and Bloxstrap Gold is 100% free and open-source forever."
                           TextWrapping="Wrap" Foreground="{StaticResource GoldLightBrush}" FontSize="13" LineHeight="18" />
            </StackPanel>
        </Border>

        <!-- Credits -->
        <TextBlock Text="Credits &amp; Acknowledgements" FontSize="20" FontWeight="Medium" Margin="0,20,0,0" />
        <TextBlock Text="Special thanks and credit to the open-source projects that make this bootstrapper and multi-instance launching possible:"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

        <Border Padding="14" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
            <StackPanel>
                <controls:MarkdownTextBlock MarkdownText="• **[MultipleRobloxInstances](https://github.com/Avaluate/MultipleRobloxInstances)** by **Avaluate / Fliktem** — pioneer of the C# Windows singleton mutex bypass for multiple client sessions." />
                <controls:MarkdownTextBlock MarkdownText="• **[Roblox Account Manager (RAM)](https://github.com/ic3w0lf22/Roblox-Account-Manager)** by **ic3w0lf22** — comprehensive multi-account and multi-instance tool." />
                <controls:MarkdownTextBlock MarkdownText="• **[Fishstrap](https://github.com/fishstrap/fishstrap)** — inspiration for the MultiInstanceWatcher background architecture." />
                <controls:MarkdownTextBlock MarkdownText="• **[Bloxstrap](https://github.com/bloxstraplabs/bloxstrap)** by **pizzaboxer** and contributors — the foundation upon which this Gold edition is built." />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:UiPage>
